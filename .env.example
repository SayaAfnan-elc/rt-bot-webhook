# Konfigurasi Bot Telegram
# Dapatkan dari @BotFather di Telegram
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ123456789

# ID Akun atau ID Grup Telegram penerima notifikasi
# Dapatkan lewat @userinfobot atau buka https://api.telegram.org/bot<TOKEN>/getUpdates
CHAT_ID=123456789

# Port Server Webhook (Opsional, Render/Railway akan mengisinya otomatis)
PORT=5000

# Zona waktu untuk timestamp pesan (misal: Asia/Jakarta, Asia/Makassar, Asia/Jayapura)
TIMEZONE=Asia/Jakarta
